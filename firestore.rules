rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidPlatform(platform) {
      return platform is string && platform in ['facebook', 'linkedin', 'x', 'reddit', 'custom'];
    }

    function isValidDateFilter(dateFilter) {
      return dateFilter is string && dateFilter in ['24h', '7d', '30d', 'custom'];
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'alertThreshold',
        'alertRecipient', 'defaultKeywords', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'displayName', 'alertThreshold',
        'alertRecipient', 'defaultKeywords', 'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
      && data.displayName is string && data.displayName.size() <= 120
      && data.alertThreshold is int && data.alertThreshold >= 0 && data.alertThreshold <= 100
      && data.alertRecipient is string && data.alertRecipient.size() >= 3 && data.alertRecipient.size() <= 254
      && data.defaultKeywords is string && data.defaultKeywords.size() <= 200
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidCampaign(data) {
      return data.keys().hasAll([
        'ownerId', 'platform', 'dateFilter', 'customDate', 'keywords',
        'targetUrl', 'status', 'leadsFoundCount', 'highValueCount',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerId', 'platform', 'dateFilter', 'customDate', 'keywords',
        'targetUrl', 'status', 'leadsFoundCount', 'highValueCount',
        'createdAt', 'updatedAt'
      ])
      && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
      && isValidPlatform(data.platform)
      && isValidDateFilter(data.dateFilter)
      && data.customDate is string && data.customDate.size() <= 40
      && data.keywords is string && data.keywords.size() <= 200
      && data.targetUrl is string && data.targetUrl.size() <= 500
      && data.status is string && data.status in ['running', 'completed', 'failed']
      && data.leadsFoundCount is int && data.leadsFoundCount >= 0 && data.leadsFoundCount <= 1000
      && data.highValueCount is int && data.highValueCount >= 0 && data.highValueCount <= 1000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidLead(data) {
      return data.keys().hasAll([
        'ownerId', 'campaignId', 'platform', 'accountName', 'postDate',
        'work', 'post', 'link', 'contact', 'aiScore', 'scoreTier',
        'aiRationale', 'suggestedPitch', 'alertSent', 'status',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerId', 'campaignId', 'platform', 'accountName', 'postDate',
        'work', 'post', 'link', 'contact', 'aiScore', 'scoreTier',
        'aiRationale', 'suggestedPitch', 'alertSent', 'status',
        'tags', 'createdAt', 'updatedAt'
      ])
      && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
      && isValidId(data.campaignId)
      && isValidPlatform(data.platform)
      && data.accountName is string && data.accountName.size() >= 1 && data.accountName.size() <= 160
      && data.postDate is string && data.postDate.size() >= 1 && data.postDate.size() <= 60
      && data.work is string && data.work.size() >= 1 && data.work.size() <= 200
      && data.post is string && data.post.size() >= 1 && data.post.size() <= 4000
      && data.link is string && data.link.size() <= 1000
      && data.contact is string && data.contact.size() <= 300
      && data.aiScore is int && data.aiScore >= 0 && data.aiScore <= 100
      && data.scoreTier is string && data.scoreTier in ['high', 'medium', 'low']
      && data.aiRationale is string && data.aiRationale.size() <= 600
      && data.suggestedPitch is string && data.suggestedPitch.size() <= 2000
      && data.alertSent is bool
      && data.status is string && data.status in ['new', 'contacted', 'archived']
      && (!('tags' in data) || (
        data.tags is list
        && data.tags.size() <= 8
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() >= 1 && data.tags[0].size() <= 24))
      ))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAlertLog(data) {
      return data.keys().hasAll([
        'ownerId', 'leadIds', 'recipientEmail', 'subject',
        'highValueCount', 'gmailMessageId', 'sentAt'
      ])
      && data.keys().hasOnly([
        'ownerId', 'leadIds', 'recipientEmail', 'subject',
        'highValueCount', 'gmailMessageId', 'sentAt'
      ])
      && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == request.auth.uid
      && data.leadIds is list && data.leadIds.size() >= 1 && data.leadIds.size() <= 50
      && data.leadIds[0] is string && data.leadIds[0].size() >= 1 && data.leadIds[0].size() <= 128
      && data.recipientEmail is string && data.recipientEmail.size() >= 3 && data.recipientEmail.size() <= 254
      && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 240
      && data.highValueCount is int && data.highValueCount >= 1 && data.highValueCount <= 50
      && data.gmailMessageId is string && data.gmailMessageId.size() >= 1 && data.gmailMessageId.size() <= 128
      && data.sentAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'alertThreshold', 'alertRecipient', 'defaultKeywords', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /campaigns/{campaignId} {
      allow get: if isValidId(campaignId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(campaignId)
        && isVerified()
        && isValidCampaign(incoming())
        && incoming().status in ['running', 'completed']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(campaignId)
        && isVerified()
        && isOwner(existing().ownerId)
        && isValidCampaign(incoming())
        && existing().status == 'running'
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'leadsFoundCount', 'highValueCount', 'updatedAt'
        ]);
      allow delete: if isValidId(campaignId)
        && isVerified()
        && isOwner(existing().ownerId);
    }

    match /leads/{leadId} {
      allow get: if isValidId(leadId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(leadId)
        && isVerified()
        && isValidLead(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/campaigns/$(incoming().campaignId))
        && get(/databases/$(database)/documents/campaigns/$(incoming().campaignId)).data.ownerId == request.auth.uid;
      allow update: if isValidId(leadId)
        && isVerified()
        && isOwner(existing().ownerId)
        && isValidLead(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().campaignId == existing().campaignId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['tags', 'updatedAt'])) ||
          (existing().alertSent == false && incoming().alertSent == true && incoming().diff(existing()).affectedKeys().hasOnly(['alertSent', 'updatedAt']))
        );
      allow delete: if isValidId(leadId)
        && isVerified()
        && isOwner(existing().ownerId);
    }

    match /alertLogs/{alertId} {
      allow get: if isValidId(alertId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(alertId)
        && isVerified()
        && isValidAlertLog(incoming())
        && incoming().sentAt == request.time;
      allow update: if false;
      allow delete: if isValidId(alertId)
        && isVerified()
        && isOwner(existing().ownerId);
    }
  }
}
